<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
            android:layout="@layout/about_teaser"/>
    <Preference
            android:key="kitchen_attribution"
            android:title="@string/kitchen_brand_attribution_title"
            android:summary="@string/kitchen_brand_attribution"/>
    <Preference
            android:key="kitchen_source"
            android:title="@string/kitchen_brand_source"
            android:summary="github.com/Braieyre/AntennaPod"
            >
        <intent android:action="android.intent.action.VIEW" android:data="https://github.com/Braieyre/AntennaPod/tree/feat/sixmin-zip-library"/>
    </Preference>
    <Preference
            android:key="about_version"
            android:title="@string/kitchen_brand_version"
            android:icon="@drawable/ic_star"
            android:summary="1.7.2 (asd8qs)"/>
    <Preference
            android:key="about_contributors"
            android:icon="@drawable/ic_contributors"
            android:summary="@string/contributors_summary"
            android:title="@string/contributors"/>
    <Preference
            android:key="about_privacy_policy"
            android:icon="@drawable/ic_policy"
            android:summary="www.antennapod.org/privacy"
            android:title="@string/privacy_policy"/>
    <Preference
            android:key="about_licenses"
            android:icon="@drawable/ic_info"
            android:summary="@string/licenses_summary"
            android:title="@string/licenses"/>

</PreferenceScreen>
